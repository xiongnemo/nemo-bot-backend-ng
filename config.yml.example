# ======================================================================
# 全局配置 (Global Configuration)
# ======================================================================

agent:
  disable_think_tool: true  # 禁用内部思考(think)工具，避免产生多余轮次和废话
  bot_names:
  - nemo
  - nemo-bot
  max_steps: 100
  trigger_prefixes:
  - nemonemo
  webhook_tokens:
  - "secret_token_123"

llm:
  timeout: 300  # 全局请求超时时间（秒），防止长思考断开
  temperature: 0.7 # 全局模型温度配置，如果不填默认为 0.7
  gatekeeper_model: nemo-axonhub-gemini:gemini-3.5-flash-lite
  reflection_model: nemo-axonhub-gemini:gemini-3.5-flash-lite
  vision_model: nemo-axonhub-openai:mimo-v2.5
  models:
  - nemo-axonhub-openai:mimo-v2.5-pro
  - nemo-axonhub-openai:gpt-5.6-sol
  - nemo-axonhub-openai:gpt-oss-120b
  - nemo-axonhub-gemini:gemini-3.5-flash-lite
  - nemo-axonhub-openai:glm-5.2
  - nemo-axonhub-openai:deepseek-v4-pro
  providers:
    # 你可以为特定 provider 单独配置 temperature，或者设为 null 让其完全不发送 temperature 参数（适用 Claude Code 等不支持的代理）
    nemo-axonhub-anthropic:
      api_key: 'your_api_key_here'
      base_url: http://192.168.1.200:8090/anthropic
      type: anthropic
      temperature: null
    nemo-axonhub-gemini:
      api_key: 'your_api_key_here'
      base_url: http://192.168.1.200:8090/gemini
      type: gemini
    nemo-axonhub-openai:
      api_key: 'your_api_key_here'
      base_url: http://192.168.1.200:8090/v1
      type: openai
    # OpenAI Responses API 示例 (适用部分新模型)
    # openai-responses-provider:
    #   api_key: 'your_api_key_here'
    #   base_url: https://api.openai.com/v1
    #   type: openai-responses

message_backend:
  console:
    endpoint: http://127.0.0.1:42165/receive
    superusers:
    - '123456789'
  cqhttp:
    endpoint: http://127.0.0.1:5700
    superusers:
    - '123456789'
  # OneBot V11 实现（NapCat/LLOneBot 等）的 HTTP API 地址。
  # 注意：使用 onebot 前端时必须配置此项，adapters/onebot.py 发送回复时直连该地址。
  onebot:
    endpoint: http://127.0.0.1:3000
    superusers:
    - '123456789'

# ======================================================================
# 好感度系统（静态基线参数；高频调参项放 plugin_config/affinity 热改配置）
# ======================================================================
affinity:
  # v2：全员从 0 分开始。等级：反感<0 / 陌生0-20 / 熟悉21-50 / 朋友51-80 / 挚友81-100
  decay_grace_days: 3     # 宽限期（天）：短暂不互动不掉分
  half_life_days: 45      # 宽限期后的半衰期，向 0 回归；曾达朋友/挚友有衰减下限保护
  daily_first_bonus: 2    # 每日初见奖励
  streak_step: 0.5        # 连续互动天数加成步长（上限 streak_max_steps 步）
  streak_max_steps: 6
  profile_share_bonus: 5  # 分享个人信息奖励（每字段一次）
  birthday_bonus: 10      # 生日当天互动惊喜
  daily_event_cap: 20     # 事件类加分每日上限（里程碑等大额峰值计入）
  daily_chat_cap: 10      # 聊天互动加分每日上限

# ======================================================================
# 反思（睡觉）机制
# ======================================================================
reflection:
  retention_days: 14    # conversations 短期对话保留天数（每日反思总结后清理），0 = 不清理

plugins: {}

acl:
  rejection_phrases:
    - "Nemo 并不是很想跟你讲话。"
    - "（系统提示）权限不足，您的消息已被丢弃。"
    - "对方拒绝了你的消息。"
    - "（已读）"

server:
  host: 0.0.0.0
  port: 42164

# ======================================================================
# 分层上下文系统（L1 群体氛围 / L2 加权历史 / L3 用户线索 / 检索 / 预算）
# ======================================================================
context:
  budget_chars: 6000        # system prompt 记忆区总字符预算，超出按优先级裁剪
  group_digest:             # L1: 群聊滚动快照（廉价模型压缩）
    enabled: true
    trigger_count: 80       # 每积累 N 条群消息压缩一次
    min_count: 10           # 或消息数达到此值且窗口超时
    max_age_seconds: 900
    max_lines: 5            # 滚动保留的快照行数
  user_thread:              # L3: 跨场景用户线索（规则写入 + LLM 压缩）
    enabled: true
    trigger_count: 8        # buffer 满 N 条触发压缩
    trigger_age_hours: 48
    expose_dm_in_group: false  # 群聊场景是否允许注入私聊来源的线索（隐私开关）
  history:                  # L2: 群聊发言者加权历史加载
    raw_turns: 60
    own_turns: 15           # 当前发言者保留的完整轮数
    other_turns_verbatim: 5 # 其他人保留原文的最近轮数（更早的折叠成前情提要）
